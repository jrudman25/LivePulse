SERVER_PORT=1234
DATABASE_URL=postgres://user:password@url/project?sslmode=require
REDIS_URL=redis://default:password@upstash-caching-url.upstash.io:30000
CLERK_SECRET_KEY=sk_test_...
EXTERNAL_API_KEY=your_ticketmaster_api_key

# Set to "production" to require all secrets, TLS URLs, and origin allowlists
APP_ENV=development

# Comma-separated origin allowlists (required when APP_ENV=production;
# when unset, HTTP CORS allows all origins and WebSocket origins fall back
# to localhost:3000 + the Vercel deployment)
CORS_ALLOWED_ORIGINS=https://livepulse-hq.vercel.app
WS_ALLOWED_ORIGINS=https://livepulse-hq.vercel.app

# Optional: protects POST /api/admin/trigger-fetch when set
ADMIN_API_KEY=
